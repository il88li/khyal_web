{
  "$schema": "https://tr.designtokens.org/format/",
  "color": {
    "primary": { "$type": "color", "$value": "#CC1728" },
    "on-primary": { "$type": "color", "$value": "#FFFFFF" },
    "primary-hover": { "$type": "color", "$value": "#A00E1E" },
    "surface": { "$type": "color", "$value": "#FFFFFF" },
    "surface-page": { "$type": "color", "$value": "#F7F8FB" },
