    "on-surface": { "$type": "color", "$value": "#12141C" },
    "on-surface-variant": { "$type": "color", "$value": "#373B48" },
    "outline": { "$type": "color", "$value": "#E0E0E0" },
    "success": { "$type": "color", "$value": "#2E7D32" },
    "warning": { "$type": "color", "$value": "#925706" },
    "error": { "$type": "color", "$value": "#B3261E" }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": "IBM Plex Sans Arabic" },
